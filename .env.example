# CMCPulse configuration — copy to .env and fill in. NEVER commit your real .env.

# Your CoinMarketCap API key (required for live data). Get one at https://pro.coinmarketcap.com
# The key is read ONLY by the server and is never sent to the browser.
CMC_API_KEY=your-cmc-api-key-here

# CMC API base URL. Production:
CMC_BASE_URL=https://pro-api.coinmarketcap.com
# Sandbox (mock data, uses the free test key printed in CMC's Quick Start docs):
# CMC_BASE_URL=https://sandbox-api.coinmarketcap.com

# Server port
PORT=3000

# Server-side cache TTL for CMC responses, in milliseconds (default 60000).
# Keeps the app well inside CMC call-credit limits.
CMC_CACHE_TTL_MS=60000

# Development only: serve recorded fixture responses (documented CMC response
# shapes) instead of calling the API. Leave unset/0 for real usage — the UI
# clearly labels fixture mode when it is on.
# CMC_FIXTURES=1
